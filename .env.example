# ── HuggingFace ─────────────────────────────────────────────────────────
# Required for speaker diarization (pyannote.audio).
# Get your token at: https://huggingface.co/settings/tokens
# HF_TOKEN=

# ── Whisper (transcription) ─────────────────────────────────────────────
# Model size: tiny, base, small, medium, large-v3
# WHISPER_MODEL=small

# Device: cpu, cuda, auto
# WHISPER_DEVICE=auto

# Provider: local (faster-whisper), hosted (external API stub)
# TRANSCRIBER_PROVIDER=local

# ── Diarization (speaker identification) ────────────────────────────────
# Provider: local (pyannote.audio), hosted (external API stub)
# Set to "local" + provide HF_TOKEN for actual diarization
# DIARIZER_PROVIDER=local
